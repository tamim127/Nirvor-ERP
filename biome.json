{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "files": {
    "includes": [
      "**",
      "!!**/dist",
      "!!**/.next",
      "!!node_modules",
      "!!.local",
      "!!artifacts",
      "!!playwright-report",
      "!!test-results",
      "!!docs",
      "!!.agents"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error"
      }
    }
  },
  "javascript": {
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    }
  }
}
